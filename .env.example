# Public browser configuration. The publishable key is designed for client use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Approved live-mode payment-provider URL. Leave unset until finance signs off.
VITE_DONATION_URL=

# Approved hosted archive file. Leave unset until the report has been migrated.
VITE_ANNUAL_REPORT_2019_20_URL=

# Edge Function secrets (set with `supabase secrets set`; never prefix these with VITE_).
PUBLIC_SITE_ORIGINS=https://noelfoundation.in,https://www.noelfoundation.in
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional private notification hook. It receives only submission kind and reference.
FORM_NOTIFICATION_WEBHOOK_URL=
